.container
  = render "shared/header"

  %main.content
    = link_to root_path, class: "back-link" do
      %span ←
      %span ボード一覧へ戻る

    .page-header
      %h1.page-title ボードを作成
      %p.page-description
        新しいボードを作成して情報を共有しましょう

    - if @board.errors.any?
      .error-message
        %h3.error-title
          入力内容をご確認ください
        %ul
          - @board.errors.full_messages.each do |message|
            %li= message

    .form-card
      = form_with model: @board, local: true do |f|
        .field
          = f.label :title, "タイトル", class: "form-label"
          = f.text_field :title,
            class: "form-input",
            placeholder: "例：法人営業一部"

        .field
          = f.label :description, "説明", class: "form-label"
          = f.text_area :description,
            class: "form-textarea",
            rows: 6,
            placeholder: "このボードの用途を入力してください"

        .actions
          = f.submit "ボードを作成", class: "btn-primary"