.container
  = render "shared/header"

  .content
    = link_to "← ボード詳細へ戻る", board_path(@board), class: "back-link"

    .page-header
      %h1.page-title 投稿詳細
      %p.page-description
        投稿内容とコメントを確認できます

    .task-card
      .task-card-header
        .task-heading
          %span.task-badge 投稿
          %h2.task-title= @task.title

        - if @task.user == current_user
          .task-menu
            %span.menu-icon ⋯

            .menu-content
              = link_to "編集する",
                edit_board_task_path(@board, @task),
                class: "menu-item"

              = button_to "削除する",
                board_task_path(@board, @task),
                method: :delete,
                data: { turbo_confirm: "本当に削除しますか？" },
                class: "menu-item delete-button"

      - if @task.eyecatch.attached?
        = image_tag @task.eyecatch, class: "task-eyecatch"

      %p.task-content= @task.content

      %p.task-deadline
        期限:
        = l @task.deadline

      .task-card-footer
        = link_to profile_path, class: "task-user-info" do
          - if @task.user.avatar.attached?
            = image_tag @task.user.avatar, class: "header-avatar"
          - else
            = image_tag "default-avatar.png", class: "header-avatar"

          .task-user-meta
            %span.task-user= @task.user.email
            %span.task-created-at= @task.created_at.strftime("%Y年%m月%d日")
    
    .comment-card
      .comments-header
        .comments-header-text
          %h2.comments-title コメント
          %p.comments-description
            この投稿へのコメントを確認できます

      - if @comment.errors.any?
        .error-message
          %ul
            - @comment.errors.full_messages.each do |message|
              %li= message

      .comments
        - @comments.each do |comment|
          .comment
            .comment-header
              = link_to profile_path, class: "comment-user-info" do
                - if comment.user.avatar.attached?
                  = image_tag comment.user.avatar, class: "comment-avatar"
                - else
                  = image_tag "default-avatar.png", class: "comment-avatar"

                .comment-user-meta
                  %span.comment-user= comment.user.email
                  %span.comment-created-at
                    = comment.created_at.strftime("%Y年%m月%d日 %H:%M")

            %p.comment-content= comment.content

      .comment-form
        %h3.comment-form-title コメントを投稿

        = form_with model: [@board, @task, @comment], local: true do |f|
          .field
            = f.text_area :content,
                class: "comment-textarea",
                placeholder: "コメントを入力..."

          .actions
            = f.submit "コメントを投稿", class: "btn-primary"